<ResourceDictionary
    x:Class="Bortle.NINA.Emitter.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:events="clr-namespace:Bortle.NINA.Emitter.Events"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:go="clr-namespace:Bortle.NINA.Emitter.UI.GlobalOptions">
    <!--  This data template will be displayed in N.I.N.A. on the options->plugin tab with the datacontext of the EmitterPlugin instance  -->
    <!--  In order for this datatemplate to be picked correctly, the key has to follow the naming convention of <IPlugin.Name>_Options -->
    <!--  Furthermore the Resource Dictionary has to be exported via code behind export attributes  -->
    <!--  Field/command bindings target EmitterPlugin.OptionsVM (GlobalOptionsViewModel); see UI/GlobalOptions  -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <go:NullOrEmptyStringToVisibilityConverter x:Key="ErrorToVis" />

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,3,10,3" />
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Fill" Value="Gray" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static events:ConnectionState.Connecting}">
                <Setter Property="Fill" Value="Goldenrod" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static events:ConnectionState.Connected}">
                <Setter Property="Fill" Value="LimeGreen" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static events:ConnectionState.Faulted}">
                <Setter Property="Fill" Value="Crimson" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="Emitter_Options">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Margin="10"
                DataContext="{Binding OptionsVM}"
                Orientation="Vertical"
                TextElement.Foreground="{DynamicResource PrimaryBrush}">

                <!--  NATS  -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse DataContext="{Binding Nats}" Style="{StaticResource StatusDot}" />
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="NATS" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Text="{Binding Nats.ConnectionState}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="8">
                        <CheckBox
                            Margin="0,2,0,8"
                            Content="Enabled"
                            IsChecked="{Binding Nats.Enabled}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Url" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,3"
                                Text="{Binding Nats.Url, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Username" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,3"
                                Text="{Binding Nats.Username, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Password" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,3"
                                Text="{Binding Nats.Password, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Subject Prefix" />
                            <TextBox
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="0,3"
                                Text="{Binding Nats.SubjectPrefix, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button
                                Padding="10,10"
                                Command="{Binding SaveNatsCommand}"
                                Content="Save &amp; Apply" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Text="Applying..."
                                Visibility="{Binding Nats.IsSaving, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="Crimson"
                            Text="{Binding Nats.ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Nats.ErrorMessage, Converter={StaticResource ErrorToVis}}" />
                    </StackPanel>
                </GroupBox>

                <!--  Webhook  -->
                <GroupBox Margin="0,0,0,12">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse DataContext="{Binding Webhook}" Style="{StaticResource StatusDot}" />
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Text="Webhook" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Text="{Binding Webhook.ConnectionState}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Margin="8">
                        <CheckBox
                            Margin="0,2,0,8"
                            Content="Enabled"
                            IsChecked="{Binding Webhook.Enabled}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Url" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,3"
                                Text="{Binding Webhook.Url, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Bearer Token" />
                            <TextBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,3"
                                Text="{Binding Webhook.BearerToken, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource FieldLabel}"
                                Text="Timeout (s)" />
                            <TextBox
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="80"
                                Margin="0,3"
                                HorizontalAlignment="Left"
                                Text="{Binding Webhook.TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Button
                                Padding="10,10"
                                Command="{Binding SaveWebhookCommand}"
                                Content="Save &amp; Apply" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Opacity="0.7"
                                Text="Applying..."
                                Visibility="{Binding Webhook.IsSaving, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="Crimson"
                            Text="{Binding Webhook.ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Webhook.ErrorMessage, Converter={StaticResource ErrorToVis}}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
